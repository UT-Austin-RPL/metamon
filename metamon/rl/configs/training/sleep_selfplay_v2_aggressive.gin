# Aggressive Filtered-BC + DPG Mix (sleep_selfplay_v2_aggressive.gin)
#
# Differences from sleep_selfplay_v1.gin:
#   - Adds online_coeff (DPG) for active exploration: 0.15 (vs 0.0)
#   - Proper warmup: 1e-6 → 8e-6 over 2000 steps (vs 1e-9 → 6e-6 over 100 steps)
#   - Modest LR increase: max 8e-6 (vs 6e-6)
#
# Philosophy:
#   - Mix filtered BC (85%) with DPG (15%) for more aggressive adaptation
#   - Proper warmup (10k steps) lets critic adapt before actor takes big steps
#   - Dynamic damping remains primary safety mechanism
#
# NOTE: This gin assumes the same AggressiveShapedRewardSleep reward function is used
#       during training and selfplay data generation.

import amago.agent

# =========================
# Reward scaling
# =========================
agent.Agent.reward_multiplier = 0.05
agent.MultiTaskAgent.reward_multiplier = 0.05

agent.Agent.tau = .004
agent.MultiTaskAgent.tau = .004

agent.Agent.num_actions_for_value_in_critic_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_critic_loss = 3

agent.Agent.num_actions_for_value_in_actor_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_actor_loss = 3

# =========================
# Data mix: Filtered BC (85%) + DPG (15%)
# =========================
# Actor learns from both offline data AND online gradient policy improvement
agent.Agent.online_coeff  = 0.15   # Add DPG for exploration
agent.MultiTaskAgent.online_coeff  = 0.15

agent.Agent.offline_coeff = 0.85   # Primary signal still from FBC
agent.MultiTaskAgent.offline_coeff = 0.85

# Advantage-filtered BC: imitate only clearly good actions.
# binary_filter should implement A > tau with tau tuned so ~20–40% of actions are kept.
agent.Agent.fbc_filter_func = @agent.binary_filter
agent.MultiTaskAgent.fbc_filter_func = @agent.binary_filter

# =========================
# Optimizer / critic emphasis
# =========================
MetamonAMAGOExperiment.l2_coeff = 5e-5

# Proper warmup: start from usable LR, ramp over several thousand steps
# This lets critic adapt before actor makes aggressive moves
MetamonAMAGOExperiment.learning_rate = 1e-6   # Start usable, not neutered
MetamonAMAGOExperiment.lr_warmup_steps = 10000  # ~8-20% of epoch 0 depending on dataset size
MetamonAMAGOExperiment.max_lr = 8e-6          # Modest increase from v1's 6e-6
MetamonAMAGOExperiment.min_lr = 1e-6

MetamonAMAGOExperiment.grad_clip = 0.3

# Critic learns the Nash-style selfplay returns under the same reward.
MetamonAMAGOExperiment.critic_loss_weight = 1.5

# =========================
# Dynamic Damping (KL): slightly relaxed for DPG
# =========================
MetamonAMAGOExperiment.use_dynamic_damping = True

# Allow slightly more policy drift with DPG active, but not too much
MetamonAMAGOExperiment.target_kl_per_step = 0.012    # Modest increase from v1's 0.010
MetamonAMAGOExperiment.kl_tolerance       = 1.25     # band ≈ [0.0096, 0.015]

# Strong initial damping; allow going stiffer if KL spikes.
MetamonAMAGOExperiment.kl_coef_init = 0.6            # Same as v1
MetamonAMAGOExperiment.kl_coef_max  = 1.2

# Controller window / adaptation frequency.
# dd_adapt_interval is the parameter actually used in the current implementation.
# It controls both the averaging window and adaptation period.
MetamonAMAGOExperiment.dd_adapt_interval   = 10     # adapt every 10 training steps

# When KL is high: hit the brakes hard (bump kl_coef, shrink LR).
MetamonAMAGOExperiment.kl_coef_growth_factor = 1.8
MetamonAMAGOExperiment.lr_shrink_factor      = 0.5

# When KL is low: relax slowly (reduce kl_coef a bit, grow LR slowly).
MetamonAMAGOExperiment.kl_coef_decay_factor  = 0.97
MetamonAMAGOExperiment.lr_grow_factor        = 1.05

# No power-law decay; controller only.
MetamonAMAGOExperiment.kl_power_alpha    = 0.0
MetamonAMAGOExperiment.kl_schedule_steps = 1_000_000

# =========================
# Entropy schedule (unchanged)
# =========================
MetamonAMAGOExperiment.ent_coef_init = 0.02
MetamonAMAGOExperiment.ent_coef_min  = 0.003

MetamonAMAGOExperiment.ent_power_alpha = 0.3
MetamonAMAGOExperiment.ent_schedule_steps = 1_000_000

# =========================
# Expected behavior with DPG mix and proper warmup
# =========================
#   - First 2000 steps: LR ramps 1e-6 → 8e-6, critic adapts, actor gradual
#   - KL Divergence: ~0.012–0.020 range (slightly higher than pure BC due to DPG)
#   - Policy should adapt more aggressively while staying stable
#   - Critic loss decreases smoothly during warmup, stabilizes after
#   - Actor Grad Norm: moderate, higher than v1 (DPG contributes gradient signal)
#   - FBC approval rate: ~0.2–0.4 (filter selects clearly good actions)
#   - Win rate: should improve faster than pure BC version
#
# Red flags:
#   - KL persistently > 0.03: too hot; DPG might be too strong
#   - Actor Grad Norm exploding early: warmup might be too fast, extend to 3-5k steps
#   - FBC approval rate < 0.1 or > 0.6: advantage threshold needs tuning
#   - Win rate decreasing: policy collapse, revert to pure BC or reduce online_coeff
