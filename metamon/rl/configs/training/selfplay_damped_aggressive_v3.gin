# Ultra-Conservative Aggressive Sleep Finetuning (v3)
#
# This configuration is designed for SAFE finetuning of a strong pretrained policy.
# After two failures (v1 collapsed completely, v2 had KL drift to 0.08), this config
# prioritizes stability over speed.
#
# Philosophy: "Metamon-style offline BC + tiny RL nudge"
# We're not learning Gen1 OU from scratch - we're nudging a strong policy into
# a slightly different reward/team distribution regime.
#
# Key changes from v2:
#   - Learning rates: 1e-5 → 3e-6 (tiny PPO steps)
#   - KL target: 0.015 → 0.010 (much tighter)
#   - Initial damping: 0.30 → 0.40 (stronger start)
#   - Adaptation frequency: 50 → 25 steps (faster reaction)
#   - Controller aggression: 1.4x → 1.8x growth when KL high
#   - Critic weight: 3.0 → 2.0 (don't flatten advantages)

import amago.agent

# =========================
# Reward Shaping: Keep v2 Settings
# =========================
# AggressiveShapedRewardSleep: +200/0 win/loss, rescaled to effective ~10
agent.Agent.reward_multiplier = 0.05
agent.MultiTaskAgent.reward_multiplier = 0.05

# Target network update rate
agent.Agent.tau = .004
agent.MultiTaskAgent.tau = .004

# Number of actions sampled for value estimation
agent.Agent.num_actions_for_value_in_critic_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_critic_loss = 3

agent.Agent.num_actions_for_value_in_actor_loss = 1
agent.MultiTaskAgent.num_actions_for_value_in_actor_loss = 3

# =========================
# Data Mix: Keep BC-Heavy
# =========================
# Pure offline with BC-heavy mix for stability
agent.Agent.online_coeff = 0.25          # Small DPG signal
agent.MultiTaskAgent.online_coeff = 0.25

agent.Agent.offline_coeff = 0.75         # Heavy BC for stability
agent.MultiTaskAgent.offline_coeff = 0.75

# Keep advantage filtering
agent.Agent.fbc_filter_func = @agent.binary_filter
agent.MultiTaskAgent.fbc_filter_func = @agent.binary_filter

# =========================
# Core Optimizer Settings: MUCH MORE CONSERVATIVE
# =========================
MetamonAMAGOExperiment.l2_coeff = 5e-5

# STRONGLY REDUCED learning rates for strong-policy finetune
# We're nudging, not relearning
MetamonAMAGOExperiment.learning_rate = 3e-6      # Was 1e-5 (3× smaller)
MetamonAMAGOExperiment.lr_warmup_steps = 500     # Short warmup
MetamonAMAGOExperiment.max_lr = 6e-6             # Was 2e-5 (3× smaller)
MetamonAMAGOExperiment.min_lr = 1e-6             # Keep floor

MetamonAMAGOExperiment.grad_clip = 0.3           # Tight gradient clipping

# Modest critic loss weight - don't let critic race ahead and flatten advantages
# This is finetuning a strong policy on offline data, not value bootstrapping
MetamonAMAGOExperiment.critic_loss_weight = 2.0  # Was 3.0

# =========================
# Dynamic Damping (KL): STRICT CONTROL
# =========================
MetamonAMAGOExperiment.use_dynamic_damping = True

# Strict KL target with tight tolerance
# No "slightly looser" - we saw what happens when KL gets loose
MetamonAMAGOExperiment.target_kl_per_step = 0.010   # Was 0.015 (tighter)
MetamonAMAGOExperiment.kl_tolerance = 1.25          # Was 1.5 (tighter band: [0.008, 0.0125])

# Strong initial damping with high ceiling
# Start stiff, allow controller to crank higher if needed
MetamonAMAGOExperiment.kl_coef_init = 0.40       # Was 0.30 (stronger)
MetamonAMAGOExperiment.kl_coef_max = 1.00        # Was 0.60 (higher ceiling)

# Much faster adaptation: check every 25 steps instead of 50
# React to KL spikes 2× faster
MetamonAMAGOExperiment.dd_adapt_interval = 25    # Was 50 (faster)

# POWER-LAW SCHEDULE DISABLED
# No automatic decay - controller handles all adaptation
MetamonAMAGOExperiment.kl_power_alpha = 0.0
MetamonAMAGOExperiment.kl_schedule_steps = 1_000_000

# STRONGER controller reactions when KL is high
# Make the brake bite harder
MetamonAMAGOExperiment.lr_shrink_factor = 0.5       # Keep - halve LR when KL high
MetamonAMAGOExperiment.lr_grow_factor = 1.05        # Was 1.07 (slower regrowth)

MetamonAMAGOExperiment.kl_coef_growth_factor = 1.8  # Was 1.4 (stronger reaction)
MetamonAMAGOExperiment.kl_coef_decay_factor = 0.97  # Was 0.96 (gentle relax)

# =========================
# Dynamic Damping (Entropy): Keep v2 Settings
# =========================
# Entropy didn't cause the collapse - KL did
MetamonAMAGOExperiment.ent_coef_init = 0.02
MetamonAMAGOExperiment.ent_coef_min = 0.003

# Gentle entropy decay
MetamonAMAGOExperiment.ent_power_alpha = 0.3
MetamonAMAGOExperiment.ent_schedule_steps = 1_000_000

# =========================
# Expected Behavior
# =========================
# What "healthy" looks like for strong-policy finetune:
#
# KL Divergence:
#   - Peaks around 0.012-0.020 early
#   - Controller adjusts occasionally but KL NEVER > 0.03
#   - If KL > 0.03 for >50-100 steps → ABORT and tweak further
#
# Damping/KL Coefficient:
#   - Starts at 0.40
#   - Might bump to ~0.7 on first spike
#   - Then drifts slightly as controller adapts
#
# Damping/Learning Rate:
#   - Starts at 3e-6
#   - Drops to ~1.5e-6 when KL high
#   - Slowly regrows to ~4e-6 when stable
#   - Should adapt every 25 steps (visible in logs)
#
# Grad Norms:
#   - Actor and critic grad norms non-zero, same order of magnitude
#   - Actor maybe 0.5-1× critic
#   - Should NOT collapse to ~0 before end of epoch
#   - Some jitter is healthy
#
# Policy Entropy:
#   - Starts near pretrained policy level
#   - Drifts slowly down, no jumps or cliffs
#   - Should stay > 1.0
#
# Runtime Gate:
#   - If median KL in first 200 steps > 0.03 → STOP RUN
#   - If KL stays near 0.01 and grad norms look sane → finish Epoch 0, then eval
#
# Success indicators:
#   - KL stays 0.008-0.020 throughout training
#   - Controller adapts every 25 steps (visible in metrics)
#   - Win rate improves gradually without collapse
#   - Sleep move usage increases
#
# Red flags:
#   - KL > 0.03 persistently: Config still too hot, abort
#   - Entropy < 0.5: Policy collapsed despite ultra-conservative settings
#   - Grad norms → 0: Value head killing actor signal
#   - No learning progress: May need to relax slightly (but be very cautious)
#
# Changes from v2 (which had KL drift to 0.08):
#   - learning_rate: 1e-5 → 3e-6 (much smaller updates)
#   - target_kl_per_step: 0.015 → 0.010 (stricter target)
#   - kl_coef_init: 0.30 → 0.40 (stronger initial damping)
#   - dd_adapt_interval: 50 → 25 (faster reaction)
#   - kl_coef_growth_factor: 1.4 → 1.8 (stronger brake)
#   - critic_loss_weight: 3.0 → 2.0 (less aggressive value learning)
