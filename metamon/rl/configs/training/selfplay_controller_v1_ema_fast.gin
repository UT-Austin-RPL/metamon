# Controller v1 + EMA (Fast Decay)
#
# Fast decay rate for EMA ablation: tests if shorter memory window improves performance.
# Effective window: ~100 gradient steps

include 'metamon/rl/configs/training/selfplay_controller_v1.gin'

# Enable EMA with fast decay
MetamonAMAGOExperiment.use_ema = True
MetamonAMAGOExperiment.ema_decay = 0.99            # Fast: ~100 step window
MetamonAMAGOExperiment.ema_update_interval = 1     # Update every gradient step
MetamonAMAGOExperiment.ema_warmup_steps = 0        # Start immediately
MetamonAMAGOExperiment.ema_eval_only = True        # Training: current, Eval: EMA
